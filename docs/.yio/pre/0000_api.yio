-- Draws the scripting API as one table, read out of scripting-api.md so
-- that the table and the document cannot drift apart.
--
--   yio search             every keyword and built-in
--   yio search file path   only the rows that mention both words
--   yio search SORT        the same as `sort`: case does not count
--
-- This is what answers the `search` command of the yio.md beside it. A
-- plugin is told the part of the command line that is for its yio.md, so
-- it works the same where that file is embedded: `yio docs search file`.

(var words (args))

-- Stay out of the way of every other command, and of `--help`.
(if (or (not (= (first words) "search")) (= (env "YIO_HELP") "true"))
  return)

-- What follows `search`, apart from the `--` that ends the flags.
(var terms (filter (rest words) (fn (word) (not (= word "--")))))

-- Lowering both sides is how text is matched without regard to case.
(fn mentions-every-term (text)
  (var lowered (lower text))
  (is-empty (filter terms (fn (term) (not (contains lowered (lower term)))))))

-- A row of the document's tables that describes a call starts like this.
(var marker "| `(")

-- The heading a row sits under names its group.
(var group "")
(var total 0)
(var rows ())

-- One cell of a Markdown table row, without its code marks.
(fn cell (row index)
  (trim (replace (nth (split row "|") index) "`" "")))

(map (lines (read-file "scripting-api.md"))
  (fn (line)
    (if (or (starts-with line "## ") (starts-with line "### "))
      (set group (trim (replace line "#" ""))))
    (if (starts-with line marker)
      (do
        (set total (+ total 1))
        (var row (list (cell line 1) group (cell line 2)))
        (if (mentions-every-term (join row " "))
          (set rows (append rows row)))))))

(var wanted (join terms " "))

(if (is-empty rows)
  (return (str "None of the " total " calls mention: " wanted)))

(fn column (header index)
  (col-def header (map rows (fn (row) (nth row index)))))

(list
  (if (not (is-empty terms))
    (str (len rows) " of " total " calls mention: " wanted))
  (col
    (column "Call" 0)
    (column "Group" 1)
    (column "Gives" 2)))
